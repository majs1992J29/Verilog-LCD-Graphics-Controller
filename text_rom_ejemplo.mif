-- Quartus II generated Memory Initialization File (.mif)

WIDTH=7;
DEPTH=1920;

ADDRESS_RADIX=HEX;
DATA_RADIX=HEX;

CONTENT BEGIN

[0..77F] : 0;


34D : 30 ; -- 0
34E : 31 ; -- 1
34F : 32 ; -- 2
350 : 33 ; -- 3
351 : 34 ; -- 4
352 : 35 ; -- 5
353 : 36 ; -- 6
354 : 37 ; -- 7
355 : 38 ; -- 8
356 : 39 ; -- 9



END;
